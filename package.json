{
  "name": "gaussian-copilot",
  "displayName": "Gaussian Copilot",
  "description": "Gaussian .log/.out visualization and .gjf submission copilot for computational chemistry",
  "keywords": [
    "gaussian",
    "computational chemistry",
    "chemistry",
    "gjf",
    "log visualization",
    "pbs"
  ],
  "version": "0.5.0",
  "publisher": "linsay",
  "license": "MIT",
  "homepage": "https://github.com/cfx2020/Gaussian-Copilot",
  "bugs": {
    "url": "https://github.com/cfx2020/Gaussian-Copilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cfx2020/Gaussian-Copilot.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon-gaussian-copilot.png",
  "activationEvents": [
    "onCommand:chemAssist.visualizeLog",
    "onCommand:chemAssist.submitGjf",
    "onCommand:chemAssist.batchSubmitGjf",
    "onCommand:chemAssist.batchVisualizeLog",
    "onCommand:chemAssist.applyGjfTemplate",
    "onCommand:chemAssist.refreshJobs",
    "onCommand:chemAssist.cancelJob",
    "onCommand:chemAssist.removeJob",
    "onCommand:chemAssist.clearFinishedJobs",
    "onCommand:chemAssist.openJobOutput",
    "onCommand:chemAssist.openJobGjf",
    "onCommand:chemAssist.downloadJobOutput",
    "onCommand:chemAssist.resubmitJob",
    "onView:chemAssist.jobView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chemAssist.visualizeLog",
        "title": "可视化此log/out"
      },
      {
        "command": "chemAssist.submitGjf",
        "title": "提交此gjf"
      },
      {
        "command": "chemAssist.batchSubmitGjf",
        "title": "Gaussian Copilot: 提交选中gjf文件"
      },
      {
        "command": "chemAssist.batchVisualizeLog",
        "title": "Gaussian Copilot: 可视化选中log/out文件"
      },
      {
        "command": "chemAssist.applyGjfTemplate",
        "title": "应用GJF模板"
      },
      {
        "command": "chemAssist.refreshJobs",
        "title": "刷新作业状态"
      },
      {
        "command": "chemAssist.cancelJob",
        "title": "⚠ 杀掉此作业"
      },
      {
        "command": "chemAssist.removeJob",
        "title": "删除此作业"
      },
      {
        "command": "chemAssist.clearFinishedJobs",
        "title": "清理已结束作业"
      },
      {
        "command": "chemAssist.openJobOutput",
        "title": "可视化选中log/out"
      },
      {
        "command": "chemAssist.openJobGjf",
        "title": "打开选中gjf"
      },
      {
        "command": "chemAssist.downloadJobOutput",
        "title": "下载选中log/out"
      },
      {
        "command": "chemAssist.resubmitJob",
        "title": "重新提交选中gjf"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "chemAssist.jobView",
          "name": "Gaussian 作业看板",
          "icon": "media/icon-gaussian-copilot.png"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "chemAssist.visualizeLog",
          "group": "navigation@10",
          "when": "resourceFilename =~ /\\.(log|out)$/i"
        },
        {
          "command": "chemAssist.submitGjf",
          "group": "navigation@11",
          "when": "resourceExtname == .gjf"
        }
      ],
      "editor/context": [
        {
          "command": "chemAssist.applyGjfTemplate",
          "when": "resourceExtname == .gjf"
        }
      ],
      "explorer/context": [
        {
          "command": "chemAssist.batchSubmitGjf",
          "when": "!explorerResourceIsFolder && resourceExtname == .gjf",
          "group": "navigation@20"
        },
        {
          "command": "chemAssist.batchVisualizeLog",
          "when": "!explorerResourceIsFolder && resourceFilename =~ /\\.(log|out)$/i",
          "group": "navigation@21"
        }
      ],
      "view/title": [
        {
          "command": "chemAssist.refreshJobs",
          "when": "view == chemAssist.jobView",
          "group": "navigation"
        },
        {
          "command": "chemAssist.clearFinishedJobs",
          "when": "view == chemAssist.jobView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "chemAssist.cancelJob",
          "when": "view == chemAssist.jobView && viewItem == chemAssistJobItem",
          "group": "navigation@5"
        },
        {
          "command": "chemAssist.openJobOutput",
          "when": "view == chemAssist.jobView && viewItem == chemAssistJobItem",
          "group": "navigation@2"
        },
        {
          "command": "chemAssist.resubmitJob",
          "when": "view == chemAssist.jobView && viewItem == chemAssistJobItem",
          "group": "navigation@3"
        },
        {
          "command": "chemAssist.removeJob",
          "when": "view == chemAssist.jobView && viewItem == chemAssistJobItem",
          "group": "navigation@4"
        },
        {
          "command": "chemAssist.openJobGjf",
          "when": "view == chemAssist.jobView && viewItem == chemAssistJobItem",
          "group": "navigation@1"
        },
        {
          "command": "chemAssist.downloadJobOutput",
          "when": "view == chemAssist.jobView && viewItem == chemAssistJobItem",
          "group": "navigation@2.5"
        }
      ]
    },
    "configuration": {
      "title": "Gaussian Copilot",
      "properties": {
        "gaussianCopilot.submit.runCommandTemplate": {
          "type": "string",
          "default": "gsub {file}",
          "description": "Run submit command template. Supported placeholders: {file}, {basename}, {dir}."
        },
        "gaussianCopilot.submit.preCommands": {
          "type": "array",
          "default": [
            "source ~/.bashrc"
          ],
          "items": {
            "type": "string"
          },
          "description": "Commands to run before submit command (e.g. module load gaussian)."
        },
        "gaussianCopilot.pbs.queue": {
          "type": "string",
          "default": "",
          "description": "PBS queue name."
        },
        "gaussianCopilot.pbs.nodes": {
          "type": "number",
          "default": 1,
          "description": "PBS nodes value."
        },
        "gaussianCopilot.pbs.ppn": {
          "type": "number",
          "default": 8,
          "description": "PBS ppn value."
        },
        "gaussianCopilot.pbs.walltime": {
          "type": "string",
          "default": "48:00:00",
          "description": "PBS walltime (HH:MM:SS)."
        },
        "gaussianCopilot.pbs.mem": {
          "type": "string",
          "default": "16gb",
          "description": "PBS memory setting, e.g. 16gb."
        },
        "gaussianCopilot.parser.maxFrames": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of coordinate frames kept in memory."
        },
        "gaussianCopilot.templates.custom": {
          "type": "array",
          "default": [],
          "description": "Custom .gjf templates.",
          "items": {
            "type": "object"
          }
        },
        "gaussianCopilot.jobs.autoRefreshSeconds": {
          "type": "number",
          "default": 60,
          "description": "Auto refresh interval for job status in seconds. Set 0 to disable."
        },
        "gaussianCopilot.jobs.username": {
          "type": "string",
          "default": "",
          "description": "Scheduler username used by qstat -u <username>. Leave empty to auto-detect from USER/LOGNAME/USERNAME."
        },
        "gaussianCopilot.viewer.backgroundColor": {
          "type": "string",
          "default": "white",
          "description": "3D viewer background color (CSS color), e.g. white, black, #f8fafc."
        },
        "gaussianCopilot.viewer.style": {
          "type": "string",
          "enum": [
            "ballStick",
            "cpkBallStick",
            "stick",
            "licorice",
            "sphere",
            "spacefill",
            "line"
          ],
          "default": "ballStick",
          "description": "Default 3D rendering style."
        },
        "gaussianCopilot.viewer.stickRadius": {
          "type": "number",
          "default": 0.18,
          "description": "Stick radius for 3D model rendering."
        },
        "gaussianCopilot.viewer.sphereScale": {
          "type": "number",
          "default": 0.25,
          "description": "Sphere scale for 3D model rendering."
        },
        "gaussianCopilot.viewer.vibrationFps": {
          "type": "number",
          "default": 10,
          "description": "Vibration animation FPS."
        },
        "gaussianCopilot.viewer.maxDisplayedFrequencies": {
          "type": "number",
          "default": 180,
          "description": "Maximum number of frequencies shown in list/select."
        },
        "gaussianCopilot.viewer.autoZoomOnFrameChange": {
          "type": "boolean",
          "default": true,
          "description": "Auto zoom model when switching structure frames."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.90.0",
    "3dmol": "^2.5.4",
    "echarts": "^6.0.0",
    "typescript": "^5.6.2"
  }
}
